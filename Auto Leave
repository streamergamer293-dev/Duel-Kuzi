local espEnabled = true

startBtn.MouseButton1Click:Connect(function()
	running = true
	startTime = tick()
	kicked = false
	startBtn.Text = "Running: "..timerDuration.."s"
end)

saveBtn.MouseButton1Click:Connect(function()
	getgenv().KUZI_Timer = timerDuration
	if writefile then pcall(writefile, CONFIG_FILE, tostring(timerDuration)) end
	saveBtn.Text = "Saved!"
	task.wait(1)
	saveBtn.Text = "Save Setup"
end)

toggleESPBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	toggleESPBtn.Text = "ESP: "..(espEnabled and "ON" or "OFF")
	toggleESPBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,60,60)
end)

-- ESP
local function createESP(player)
	if player == LocalPlayer then return end
	local ok, box = pcall(Drawing.new, "Square")
	if not ok then return end
	box.Visible = false
	box.Color = Color3.fromRGB(0, 255, 100)
	box.Thickness = 2
	box.Transparency = 1
	box.Filled = false
	ESPObjects[player] = box
end

local function removeESP(player)
	if ESPObjects[player] then
		pcall(function() ESPObjects[player]:Remove() end)
	ESPObjects[player] = nil
	end
end

for _, plr in ipairs(Players:GetPlayers()) do createESP(plr) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- Main Loop
RunService.RenderStepped:Connect(function()
	-- ESP
	for player, box in pairs(ESPObjects) do
		if espEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
			if onScreen then
				box.Size = Vector2.new(100, 150)
				box.Position = Vector2.new(pos.X - 50, pos.Y - 75)
				box.Visible = true
			else
				box.Visible = false
			end
		else
			box.Visible = false
		end
	end
	
	-- Timer
	if running and not kicked then
		local elapsed = tick() - startTime
		startBtn.Text = "Running: "..math.max(0, math.floor(timerDuration - elapsed)).."s"
		
		if elapsed >= timerDuration then
			kicked = true
			running = false
			for _, box in pairs(ESPObjects) do pcall(function() box:Remove() end) end
			LocalPlayer:Kick("[KUZI HUB] Timer hit "..timerDuration.." seconds")
		end
	end
end)
